class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:

        nums.sort()
        count=0
        ma=0
        for i in range(len(nums)):

            
            if i==len(nums)-1:
                count+=1
                ma=max(ma,count)
                break
            if nums[i]==nums[i+1]:
                continue


            if nums[i]+1==nums[i+1]:
                count+=1
            else:
                count+=1
                ma=max(ma,count)
                count=0
        return ma
        
