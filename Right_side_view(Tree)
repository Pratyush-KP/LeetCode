class Solution:
    def rightSideView(self, root: Optional[TreeNode]) -> List[int]:

        li=[]
        length=[]

        def dfs(root,i,res):

            if root == None:
                return
            if i==len(res):
                res.append(root.val)
            
            
            dfs(root.right,i+1,res)

            dfs(root.left,i+1,res)
        res=[]
        dfs(root,0,res)
        return res
